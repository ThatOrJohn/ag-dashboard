---
// Persona pages: the same data, arranged by `card_order` in regions/tx.yaml (ms-sound-check 0010).
// Crop and pasture cards that come one after another share a grid.
import Base from "../../layouts/Base.astro";
import AsOf from "../../components/AsOf.astro";
import CropCard from "../../components/CropCard.astro";
import DroughtBar from "../../components/DroughtBar.astro";
import Headline from "../../components/Headline.astro";
import MarketCard from "../../components/MarketCard.astro";
import { loadLatest } from "../../lib/data";
import { change, day, href, inches, pct } from "../../lib/format";
import type { Persona } from "../../lib/types";

export function getStaticPaths() {
  return loadLatest().personas.map((p) => ({ params: { persona: p.id }, props: { persona: p } }));
}

const { persona } = Astro.props as { persona: Persona & { blurb?: string } };
const L = loadLatest();
const S = L.sources;
const tx = L.texas;
const cattleMarkets = L.markets.filter((m) => m.kind !== "sheep_goats");
const sheepGoatMarkets = L.markets.filter((m) => m.kind === "sheep_goats");
// Featured districts first, then the rest in config order.
const allDistricts = [...L.districts.filter((d) => d.home), ...L.districts.filter((d) => !d.home)];

type Block = { kind: "cards"; items: string[] } | { kind: "section"; id: string };
const blocks: Block[] = [];
for (const id of persona.card_order) {
  const isCard = id.startsWith("crop:") || id === "pasture";
  const last = blocks[blocks.length - 1];
  if (isCard && last?.kind === "cards") last.items.push(id);
  else blocks.push(isCard ? { kind: "cards", items: [id] } : { kind: "section", id });
}
const cropKey = (id: string) => id.slice(5) as "corn" | "sorghum" | "cotton" | "wheat";
const title = (b: Block) => b.kind === "cards"
  ? (b.items.every((i) => i === "pasture") ? "Pasture" : "Crops, statewide")
  : ({ drought: "Drought", rain: "Rain", burn_bans: "Burn bans", cattle: "Cattle markets",
       sheep_goats: "Edwards Plateau sheep and goats" } as Record<string, string>)[b.id] ?? b.id;
// A section whose source isn't current says so instead of rendering an empty heading.
const ready: Record<string, boolean> = { drought: !!tx.drought, rain: !S.nclimgrid.stale, burn_bans: !!tx.burn_bans, cattle: cattleMarkets.some((m) => !m.stale) };
const notReady = (b: Block) => b.kind === "section" && ready[b.id] === false;
---
<Base title={`${persona.name}: Texas this week · Texas Ag Dashboard`} description={`${persona.name} in Texas this week: ${persona.blurb ?? ""}`} current={`for-${persona.id}`}>
  <span class="eyebrow"><a href={href()}>Texas</a> · for {persona.name} · week of {day(L.asof)}</span>
  <h1>{persona.name}</h1>
  {persona.blurb && <p class="muted">{persona.blurb}</p>}
  <Headline headline={tx.headline_all} sources={S} asof={L.asof} topics={persona.card_order} />

  {blocks.map((b, i) => (
    <section aria-labelledby={`s${i}`}>
      <h2 id={`s${i}`}>{title(b)}</h2>
      {notReady(b) && <p class="notice">This section is hidden: its source hasn't updated recently. See <a href={href("about/")}>About the data</a>.</p>}
      {b.kind === "cards" && (
        S.nass.stale ? <p class="notice">Crop reports are hidden: NASS's newest report is older than I expect.</p> : (
          <>
          <p class="muted">Statewide: NASS reports these weekly for Texas as a whole, not by district.</p>
          <div class="grid">
            {b.items.map((id) => id === "pasture"
              ? <CropCard crop="pasture" title="Pasture and range" condition={tx.pasture} source={S.nass} asof={L.asof} />
              : <CropCard crop={cropKey(id)} progress={tx.crops[cropKey(id)].progress} condition={tx.crops[cropKey(id)].condition} source={S.nass} asof={L.asof} />)}
          </div>
          </>
        )
      )}
      {b.kind === "section" && b.id === "drought" && tx.drought && (
        <>
          <p>{`${pct(tx.drought.now.d1)} of Texas is in drought (D1 or worse)` + (tx.drought.week_ago ? `, ${change(tx.drought.now.d1, tx.drought.week_ago.d1)} from last week.` : ".")}</p>
          <DroughtBar levels={tx.drought.now} label="Share of Texas by drought category" />
          <div class="table-wrap">
            <table>
              <caption class="sr-only">Drought by district</caption>
              <thead><tr><th scope="col">District</th><th class="n" scope="col">In drought (D1+)</th><th class="n" scope="col">vs last week</th><th class="n" scope="col">A year ago</th></tr></thead>
              <tbody>
                {allDistricts.map((d) => (
                  <tr><th scope="row"><a href={href(`district/${d.slug}/`)}>{d.name}</a></th>
                    <td class="n">{pct(d.drought?.now.d1)}</td>
                    <td class="n">{d.drought?.week_ago ? change(d.drought.now.d1, d.drought.week_ago.d1) : "n/a"}</td>
                    <td class="n">{pct(d.drought?.year_ago?.d1)}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <AsOf source={S.usdm} label="Map of" note="Texas is the official figure; districts are my area-weighted totals" />
        </>
      )}
      {b.kind === "section" && b.id === "rain" && !S.nclimgrid.stale && (
        <>
          <div class="table-wrap">
            <table>
              <caption class="sr-only">Rain by district</caption>
              <thead><tr><th scope="col">District</th><th class="n" scope="col">{`7 days to ${day(S.nclimgrid.as_of, L.asof)}`}</th><th class="n" scope="col">30 days, vs normal</th><th class="n" scope="col">Forecast, next 7 days</th></tr></thead>
              <tbody>
                {allDistricts.map((d) => (
                  <tr><th scope="row"><a href={href(`district/${d.slug}/`)}>{d.name}</a></th>
                    <td class="n">{inches(d.rain_7d_in)}</td><td class="n">{inches(d.rain_30d_in)}{d.rain_vs_normal?.pct != null ? ` (${d.rain_vs_normal.pct}%)` : ""}</td><td class="n">{inches(d.rain_next_7d_in)}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <AsOf source={S.nclimgrid} label="Through" note="NOAA county averages, published about a week late; % is of the 1991–2020 normal; my district totals" />
          {S.nws && !S.nws.stale && <AsOf source={S.nws} label="Forecast issued" note="at each county's center" />}
        </>
      )}
      {b.kind === "section" && b.id === "burn_bans" && tx.burn_bans && (
        <>
          <p>{`${tx.burn_bans.count} of ${tx.burn_bans.of} Texas counties have a burn ban. By district: ` +
            allDistricts.map((d) => `${d.name} ${d.burn_bans ?? "n/a"} of ${d.counties}`).join("; ") + "."}</p>
          <AsOf source={S.burn_bans} label="Updated" note="county judges set bans; check yours before burning" />
        </>
      )}
      {b.kind === "section" && b.id === "cattle" && (
        <div class="grid">{cattleMarkets.map((m) => <MarketCard market={m} source={S.ams} asof={L.asof} />)}</div>
      )}
      {b.kind === "section" && b.id === "sheep_goats" && (
        <div class="grid">{sheepGoatMarkets.map((m) => <MarketCard market={m} source={S.ams} asof={L.asof} />)}</div>
      )}
    </section>
  ))}
</Base>
