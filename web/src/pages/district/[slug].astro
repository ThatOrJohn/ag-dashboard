---
// District: the main working view. Counties are a map stop with a card, not pages of their own (docs/seed.md).
import Base from "../../layouts/Base.astro";
import AsOf from "../../components/AsOf.astro";
import Conditions from "../../components/Conditions.astro";
import CountyAnnual from "../../components/CountyAnnual.astro";
import CropCard from "../../components/CropCard.astro";
import DistrictAnnual from "../../components/DistrictAnnual.astro";
import DroughtBar from "../../components/DroughtBar.astro";
import DroughtMap from "../../components/DroughtMap.astro";
import Headline from "../../components/Headline.astro";
import MarketCard from "../../components/MarketCard.astro";
import WeatherStrip from "../../components/WeatherStrip.astro";
import WaterCard from "../../components/WaterCard.astro";
import SeasonRain from "../../components/SeasonRain.astro";
import { loadDistrict, loadLatest } from "../../lib/data";
import { category, categoryName, change, day, href, inches, pct } from "../../lib/format";

export function getStaticPaths() {
  return loadLatest().districts.map((d) => ({ params: { slug: d.slug } }));
}

const { slug } = Astro.params as { slug: string };
const L = loadLatest();
const D = loadDistrict(slug);
const S = L.sources;
const sum = D.summary;
const keep = D.counties.map((c) => c.fips);
const crops = sum.crops;
const cattleMarkets = D.markets.filter((m) => m.kind !== "sheep_goats");
const sheepGoatMarkets = D.markets.filter((m) => m.kind === "sheep_goats");
const drought = S.usdm.stale ? null : sum.drought;
const burnBans = !S.burn_bans.stale && sum.burn_bans != null ? { count: sum.burn_bans, of: sum.counties } : null;
const forecast = S.nws?.stale === false ? sum.rain_next_7d_in : null;
const hasRain = !S.nclimgrid.stale && sum.rain_7d_in != null;
const weather = !S.nclimgrid.stale && D.weather?.days.length ? D.weather : null;
const seasonRain = S.nclimgrid.stale ? null : D.season_rain;
const hasRoundup = (sum.headline?.sentences.length ?? 0) > 1;
const hasConditions = drought || hasRain || forecast != null || burnBans;
const hasWater = (D.water?.length ?? 0) > 0;
const annual = D.annual;
const hasAnnual = annual && (annual.census || Object.values(annual.crops_published ?? {}).some(Boolean)
  || annual.forage_pct_of_normal || annual.crop_mix);
const otherTopics = sum.headline?.items?.filter(({ topic }) => ["rain", "cattle"].includes(topic)).map(({ topic }) => topic);
const screwworm = L.texas.screwworm && S.screwworm && !S.screwworm.stale && !S.screwworm.delayed ? L.texas.screwworm : null;
const detection = screwworm?.recent.find((row) => D.counties.some((c) => c.name === row.county));
const pests = screwworm && detection ? [{
  label: "Livestock screwworm",
  detail: `${detection.county} County · ${day(detection.date, L.asof)}`,
  href: href("#screwworm-h"),
  validUntil: screwworm.stale_at,
}] : [];
---
<Base title={`${D.name} district, Texas: this week · Texas Ag Dashboard`} description={`Drought, rain, burn bans and cattle prices for the ${D.name} district of Texas, county by county, from public data.`} current={slug}>
  <div class="overview">
    <div>
      <span class="eyebrow"><a href={href()}>Texas</a> · NASS district{sum.home ? " · featured district" : ""} · week of {day(L.asof)}</span>
      <h1>{D.name}</h1>
      <Headline headline={sum.headline} sources={S} asof={L.asof} topics={otherTopics?.length ? otherTopics : undefined} limit={1} />
      <Conditions asof={L.asof} drought={drought} burnBans={burnBans} forecast={forecast} pests={pests} />
    </div>
    <DroughtMap counties={L.counties} keep={keep} showDrought={!S.usdm.stale} title={`${D.name} counties`} link={(f) => `#c-${f}`} countyNames />
  </div>

  <nav class="district-sections" aria-labelledby="district-sections-label">
    <p id="district-sections-label">On this page</p>
    <ul>
      {hasRoundup && <li><a href="#weekly-h">Weekly roundup</a></li>}
      {hasConditions && <li><a href="#dr-h">Drought, rain and burn bans</a></li>}
      {hasWater && <li><a href="#water-h">Water conditions</a></li>}
      {weather && <li><a href="#wx-h">Temperature and rain</a></li>}
      {seasonRain && <li><a href="#sr-h">Rain since Jan. 1</a></li>}
      <li><a href="#co-h">Counties ({sum.counties})</a></li>
      {hasAnnual && <li><a href="#land-h">The land and its farms</a></li>}
      {cattleMarkets.length > 0 && <li><a href="#mk-h">Cattle markets</a></li>}
      {sheepGoatMarkets.length > 0 && <li><a href="#sg-h">Sheep and goat market</a></li>}
      {!S.nass.stale && <li><a href="#cr-h">Crops, statewide</a></li>}
    </ul>
  </nav>

  {hasRoundup && (
    <section aria-labelledby="weekly-h">
      <h2 id="weekly-h">Weekly roundup</h2>
      <Headline headline={sum.headline} sources={S} asof={L.asof} />
    </section>
  )}

  {hasConditions && (
    <section aria-labelledby="dr-h">
      <h2 id="dr-h">Drought, rain and burn bans</h2>
      <div class="condition-details">
        {drought && (
          <div>
            <h3 id="drought-h">Drought</h3>
            <p class="big">{pct(drought.now.d1)}</p>
            <p>{`of the district is in drought (D1 or worse)`}{drought.week_ago ? `, ${change(drought.now.d1, drought.week_ago.d1)} from last week` : ""}{drought.year_ago ? `. A year ago: ${pct(drought.year_ago.d1)}` : ""}.</p>
            <DroughtBar levels={drought.now} label={`Share of ${D.name} by drought category`} />
            <AsOf source={S.usdm} label="Map of" date={drought.map_date} note="my area-weighted total of county figures" />
          </div>
        )}
        {hasRain && (
          <div>
            <h3>{`Rain through ${day(sum.rain_through, L.asof)}`}</h3>
            <dl class="kv">
              <dt>7 days</dt><dd>{inches(sum.rain_7d_in)}</dd>
              <dt>30 days</dt><dd>{inches(sum.rain_30d_in)}</dd>
              {sum.rain_vs_normal?.pct != null && (<><dt>30 days vs normal</dt><dd>{`${sum.rain_vs_normal.pct}% (normal ${inches(sum.rain_vs_normal.normal_in)})`}</dd></>)}
            </dl>
            <AsOf source={S.nclimgrid} label="Through" date={sum.rain_through} note="NOAA county averages, published about a week late; normal is 1991–2020; my district total" />
            {S.stage4 && !S.stage4.stale && sum.rain_estimate && (
              <>
                <dl class="kv">
                  <dt>{`Since then, ${day(sum.rain_estimate.from, L.asof)} to ${day(sum.rain_estimate.through, L.asof)}`}</dt>
                  <dd>{`about ${inches(sum.rain_estimate.in)} (estimate)`}</dd>
                </dl>
                <AsOf source={S.stage4} label="Through" date={sum.rain_estimate.through} note="radar adjusted to rain gauges; often a little wetter than NOAA's county averages, which replace it; my district average" />
              </>
            )}
          </div>
        )}
        {forecast != null && (
          <div>
            <h3 id="forecast-h">Rain forecast</h3>
            <dl class="kv"><dt>Rain, next 7 days</dt><dd>{inches(forecast)}</dd></dl>
            <AsOf source={S.nws} label="Issued" note="at each county's center; my district average" />
          </div>
        )}
        {burnBans && (
          <div>
            <h3 id="burn-bans-h">Burn bans</h3>
            <p>{`${burnBans.count} of ${burnBans.of} counties have a burn ban.`}</p>
            <AsOf source={S.burn_bans} label="Updated" />
          </div>
        )}
      </div>
    </section>
  )}

  {hasWater && (
    <section aria-labelledby="water-h">
      <h2 id="water-h">Water conditions</h2>
      <div class="condition-details">
        {D.water?.map((card) => <WaterCard card={card} source={S[card.source]} />)}
      </div>
    </section>
  )}

  {weather && (
    <section aria-labelledby="wx-h">
      <h2 id="wx-h">Temperature and rain</h2>
      <WeatherStrip weather={weather} name={D.name} asof={L.asof} vsNormal={sum.rain_vs_normal} />
    </section>
  )}

  {seasonRain && (
    <section aria-labelledby="sr-h">
      <h2 id="sr-h">Rain since Jan. 1</h2>
      <SeasonRain season={seasonRain} name={D.name} asof={L.asof} />
    </section>
  )}

  <section aria-labelledby="co-h">
    <h2 id="co-h">Counties</h2>
    <p class="muted">Open a county for rain, the year-ago comparison, and its farms, crops and rangeland over the years. Category is the most severe one covering at least half the county.</p>
    <div class="grid county-grid">
      {D.counties.map((c) => {
        const cat = category(c.drought);
        const short = cat < 0 ? "No drought" : `D${cat}`;
        return (
          <details class="card county-card" id={`c-${c.fips}`}>
            <summary>
              <span class="cn">{c.name}</span>
              {c.drought && <span class="cs"><span class={`sw f-${cat < 0 ? "none" : `d${cat}`}`} aria-hidden="true" />{`${short} · ${pct(c.drought.d1)} in drought`}</span>}
              {c.burn_ban && <span class="tag ban">Burn ban</span>}
            </summary>
            {c.burn_ban === false && <p><span class="tag ok">No burn ban</span></p>}
            <dl class="kv">
              {c.drought && (<><dt>Drought</dt><dd>{categoryName(cat)}</dd><dt>In drought (D1+)</dt><dd>{pct(c.drought.d1)}</dd></>)}
              {c.drought_year_ago && (<><dt>A year ago</dt><dd>{pct(c.drought_year_ago.d1)}</dd></>)}
              {c.last_7d_in != null && (<><dt>{`Rain, 7 days to ${day(c.through, L.asof)}`}</dt><dd>{inches(c.last_7d_in)}</dd></>)}
              {c.last_30d_in != null && (<><dt>{`Rain, 30 days to ${day(c.through, L.asof)}`}</dt><dd>{inches(c.last_30d_in)}{c.rain_vs_normal?.pct != null ? `, ${c.rain_vs_normal.pct}% of normal` : ""}</dd></>)}
              {S.stage4 && !S.stage4.stale && c.rain_estimate && (<><dt>{`Rain since, to ${day(c.rain_estimate.through, L.asof)}`}</dt><dd>{`about ${inches(c.rain_estimate.in)} (estimate)`}</dd></>)}
              {c.next_7d_in != null && (<><dt>Rain forecast, next 7 days</dt><dd>{inches(c.next_7d_in)}</dd></>)}
            </dl>
            <CountyAnnual annual={c.annual} sources={S} asof={L.asof} />
          </details>
        );
      })}
    </div>
    <script is:inline>
      // A map click (#c-<fips>) opens that county's card. Without JS the summary line still shows.
      (function () {
        function open() {
          var el = location.hash && document.getElementById(location.hash.slice(1));
          if (el && el.tagName === "DETAILS") { el.open = true; }
        }
        window.addEventListener("hashchange", open);
        open();
      })();
    </script>
    <p class="asof">Drought: {S.usdm.name}, map of {day(S.usdm.as_of)}. Rain: NOAA nClimGrid-Daily county averages through {day(S.nclimgrid.as_of)}{S.stage4 && !S.stage4.stale ? `, then NWS Stage IV radar-and-gauge estimates through ${day(S.stage4.as_of)}` : ""}; forecast: National Weather Service, at the county's center. Burn bans: Texas A&amp;M Forest Service, {day(S.burn_bans.as_of)}.</p>
  </section>

  {hasAnnual && <DistrictAnnual annual={annual} sources={S} asof={L.asof} name={D.name} />}

  {cattleMarkets.length > 0 && (
    <section aria-labelledby="mk-h">
      <h2 id="mk-h">Cattle markets</h2>
      <div class="grid">
        {cattleMarkets.map((m) => <MarketCard market={m} source={S.ams} asof={L.asof} />)}
      </div>
    </section>
  )}

  {sheepGoatMarkets.length > 0 && (
    <section aria-labelledby="sg-h">
      <h2 id="sg-h">Sheep and goat market</h2>
      <div class="grid">{sheepGoatMarkets.map((m) => <MarketCard market={m} source={S.ams} asof={L.asof} />)}</div>
    </section>
  )}

  {!S.nass.stale && (
    <section aria-labelledby="cr-h">
      <h2 id="cr-h">Crops, statewide</h2>
      <p class="muted">NASS reports weekly crop progress and condition for Texas as a whole, not by district.</p>
      <div class="grid">
        {crops.map((c) => <CropCard crop={c} progress={L.texas.crops[c].progress} condition={L.texas.crops[c].condition} source={S.nass} asof={L.asof} />)}
        <CropCard crop="pasture" title="Pasture and range" condition={L.texas.pasture} source={S.nass} asof={L.asof} />
      </div>
    </section>
  )}
</Base>

<style>
  .district-sections {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1.25rem;
    margin-top: 1.5rem;
    padding: .55rem 1rem;
    border-block: 1px solid var(--rule);
    background: var(--paper-2);
  }
  .district-sections p { margin: 0; font-weight: 600; }
  .district-sections ul {
    display: flex;
    flex: 1 1 24rem;
    flex-wrap: wrap;
    column-gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .district-sections a {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    font-size: .9375rem;
  }
  section > h2 { scroll-margin-top: 1rem; }
</style>
