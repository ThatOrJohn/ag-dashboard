---
import Base from "../../layouts/Base.astro";
import BandArt from "../../components/story/BandArt.astro";
import DistrictTourMap from "../../components/story/DistrictTourMap.astro";
import FlyoverCard from "../../components/story/FlyoverCard.astro";
import { href } from "../../lib/format";
import { buildStories, profileTourSlug, storiesDescription, type BuiltStory, type Story } from "../../lib/stories";

// Two kinds of story, shown as two bands side by side on wide screens so both show at once: flyovers (map
// tours of places, 0027) and replays (one measure animated over time, 0024). Each band heading has a small
// looping vignette of what that kind does, and flyovers get a route thumbnail. The district picker is a
// full-width flyover band below both (decision 0028).
interface Area {
  name: string;
  tours: BuiltStory[];
  replays: { story: Story; path: string; featured: boolean }[];
}
const areas = new Map<string, Area>();
const districtTours = new Map<string, Map<string, { name: string; id: string; profile?: BuiltStory; weekly?: BuiltStory }>>();
const areaFor = (id: string, name: string) => {
  const area = areas.get(id) ?? { name, tours: [], replays: [] };
  areas.set(id, area);
  return area;
};
for (const built of buildStories()) {
  const { area, story, path, featured, slug } = built;
  if (area.level !== "district") {
    const group = areaFor(area.id, area.name);
    if (story?.visual.kind === "flyover") group.tours.push(built);
    else if (story) group.replays.push({ story, path, featured });
  } else if (story?.visual.kind === "flyover") {
    const tours = districtTours.get(area.stateId) ?? new Map();
    const district = tours.get(area.id) ?? { name: area.name, id: area.id };
    if (slug === profileTourSlug) district.profile = built;
    else district.weekly = built;
    tours.set(area.id, district);
    districtTours.set(area.stateId, tours);
    if (featured) areas.get(area.stateId)?.tours.push(built);
  }
}
for (const [id, { tours, replays }] of areas) if (!tours.length && !replays.length && !districtTours.has(id)) areas.delete(id);
const hasChoices = areas.size > 1;
// Heading levels shift down one when several areas each get their own h2.
const base = hasChoices ? 3 : 2;
---
<Base title="Stories · Texas Ag Dashboard" description={storiesDescription} current="stories">
  <header class="collection-heading">
    <h1>Stories</h1>
    <p class="lede">Explore the dashboard’s public data two ways: <strong>flyovers</strong> tour the map and stop
      on the places worth a look, and <strong>replays</strong> animate one measure over weeks or years.</p>
  </header>
  {hasChoices && (
    <nav class="area-nav" aria-label="Story areas">
      <ul>{[...areas].map(([id, { name }]) => <li><a href={`#${id}`}>{name}</a></li>)}</ul>
    </nav>
  )}
  {[...areas].map(([id, { name, tours, replays }]) => {
    const featured = replays.filter((card) => card.featured);
    const rest = replays.filter((card) => !card.featured);
    const picks = [...(districtTours.get(id)?.values() ?? [])].sort((a, b) => a.name.localeCompare(b.name));
    const Section = `h${base}` as const;
    const Group = hasChoices ? "h4" : "h3";
    const Card = hasChoices ? "h5" : "h4";
    const groups = [
      { key: "featured", title: "Featured", cards: featured },
      { key: "archive", title: featured.length > 0 ? "More replays" : "All replays", cards: rest },
    ];
    return (
      <div id={id} class="area">
        {hasChoices && <h2>{name}</h2>}
        <div class="bands">
        {tours.length > 0 && (
          <section class="band flyovers" aria-labelledby={`${id}-flyovers`}>
            <header class="band-heading">
              <BandArt kind="flyover" id={`${id}-flyover-art`} />
              <div>
                <Section id={`${id}-flyovers`}>Flyovers</Section>
                <p>Map tours. The camera flies from place to place and stops where the data picks out something worth seeing.</p>
              </div>
            </header>
            <div class="tour-grid">{tours.map((built) => <FlyoverCard built={built} level={hasChoices ? 4 : 3} />)}</div>
          </section>
        )}
        {replays.length > 0 && (
          <section class="band replays" aria-labelledby={`${id}-replays`}>
            <header class="band-heading">
              <BandArt kind="replay" id={`${id}-replay-art`} />
              <div>
                <Section id={`${id}-replays`}>Replays</Section>
                <p>Animated charts. Press play to watch one measure change week by week or year by year.</p>
              </div>
            </header>
            {groups.filter(({ cards }) => cards.length).map(({ key, title, cards }) => (
              <section class={key === "archive" ? "archive" : undefined} aria-labelledby={`${id}-${key}`}>
                <Group class="group-heading" id={`${id}-${key}`}>{title}</Group>
                <div class={key === "featured" ? "featured-grid" : "story-grid"}>
                  {cards.map(({ story, path, featured }) => (
                    <article class:list={["card", { featured }]}>
                      <p class="eyebrow">{story.topic} · {story.period}</p>
                      <Card><a href={href(`stories/${path}/`)}>{story.title}</a></Card>
                      <p class="desc">{story.description}</p>
                      {featured && story.highlights.length > 0 && (
                        <dl class="featured-data" aria-label={story.metric}>
                          {story.highlights.map(({ label, value }) => <div><dt>{label}</dt><dd class="num">{value}</dd></div>)}
                        </dl>
                      )}
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </section>
        )}
        </div>
        {picks.length > 0 && (
          <div class="band flyovers picker">
            <DistrictTourMap region={id} name={name} tours={picks} level={base} />
          </div>
        )}
      </div>
    );
  })}
</Base>

<style>
  .collection-heading { margin-bottom: 1.5rem; }
  .collection-heading h1 { margin-bottom: .15em; }
  .collection-heading .lede { max-width: 72ch; margin: 0; }
  .collection-heading strong { font-weight: 600; color: var(--ink); }
  .area-nav ul { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding-left: 0; list-style: none; }
  .area + .area { margin-top: 2.5rem; }

  .bands { display: grid; gap: 2.5rem; }
  .bands > .band { min-width: 0; }
  .picker { margin-top: 2.5rem; }
  .picker :global(.district-tours) { margin-top: 0; }
  .picker :global(.district-tours) > :global(:is(h2, h3)) { margin-top: 0; font-size: clamp(1.4rem, 2.4vw, 1.75rem); }
  /* Wide screens: flyovers and replays side by side, so both kinds show without scrolling. */
  @media (min-width: 1024px) {
    .bands { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 1.5rem; align-items: start; }
    .bands .tour-grid { grid-template-columns: minmax(0, 1fr); }
    .bands .featured-grid { grid-template-columns: minmax(0, 1fr); }
    /* Same top inset as the flyover panel, so the two band headings line up. */
    .bands .replays { padding-top: clamp(1rem, 2.5vw, 1.5rem); }
  }
  .band-heading { display: flex; gap: .85rem; align-items: center; margin-bottom: 1rem; }
  .band-heading :is(h2, h3) { margin: 0 0 .1rem; font-size: clamp(1.4rem, 2.4vw, 1.75rem); }
  .band-heading p { margin: 0; max-width: 70ch; color: var(--ink-2); font-size: .95rem; }

  /* The flyover band sits on its own tinted panel so the two kinds never blur together. */
  .flyovers {
    padding: clamp(1rem, 2.5vw, 1.5rem); border-radius: calc(var(--radius) * 1.5);
    background: var(--paper-2); border: 1px solid var(--rule);
  }
  .tour-grid { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr)); }

  .group-heading {
    margin: 0 0 .6rem; font-family: var(--font-mono); font-weight: 500; font-size: .75rem; letter-spacing: .06em;
    text-transform: uppercase; color: var(--ink-3);
  }
  section + .archive { margin-top: 1.5rem; }
  .featured-grid, .story-grid { display: grid; gap: .75rem; }
  .featured-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); }
  .story-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); }
  /* Each card is one link target: the title link stretches over the whole card. */
  .card {
    position: relative; display: flex; flex-direction: column;
    padding: 1rem 1.1rem; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper);
  }
  .card.featured { background: var(--paper-2); }
  .card:hover, .card:focus-within { border-color: var(--accent); }
  .card .eyebrow { margin: 0 0 .35rem; }
  .card :is(h3, h4, h5) { margin: 0 0 .35rem; font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.25; }
  .card.featured :is(h3, h4, h5) { font-size: clamp(1.25rem, 2vw, 1.5rem); }
  .card a { color: var(--ink); text-decoration: none; }
  .card a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .card a:focus-visible { outline: none; }
  .card:has(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .card:hover a { color: var(--accent-ink); }
  .desc { margin: 0; color: var(--ink-2); font-size: .92rem; }
  .featured-data { margin: auto 0 0; padding-top: .75rem; display: flex; flex-wrap: wrap; gap: .25rem 1.5rem; }
  .featured-data dt { color: var(--ink-2); font-size: .8rem; }
  .featured-data dd { margin: 0; font-size: 1.3rem; }
</style>
