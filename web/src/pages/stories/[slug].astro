---
import type { GetStaticPaths } from "astro";
import { href } from "../../lib/format";
import { legacyStorySlugs } from "../../lib/stories";

export const getStaticPaths = (() => legacyStorySlugs.map((slug) => ({ params: { slug } }))) satisfies GetStaticPaths;

const target = href(`stories/tx/${Astro.params.slug}/`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>Story moved</title>
  </head>
  <body>
    <p><a href={target}>Continue to the story</a></p>
  </body>
</html>
