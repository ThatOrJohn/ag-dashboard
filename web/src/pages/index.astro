---
// Texas: the statewide this-week digest and the way into every district (featured ones first).
import Base from "../layouts/Base.astro";
import AsOf from "../components/AsOf.astro";
import CropCard from "../components/CropCard.astro";
import Conditions from "../components/Conditions.astro";
import DroughtBar from "../components/DroughtBar.astro";
import DroughtMap from "../components/DroughtMap.astro";
import Headline from "../components/Headline.astro";
import MarketCard from "../components/MarketCard.astro";
import ScrewwormCard from "../components/ScrewwormCard.astro";
import { loadLatest } from "../lib/data";
import { change, countWord, day, href, inches, pct } from "../lib/format";

const L = loadLatest();
const S = L.sources;
const tx = L.texas;
const homes = L.districts.filter((d) => d.home);
const others = L.districts.filter((d) => !d.home);
const fipsOf = (slug: string) => Object.entries(L.counties).filter(([, c]) => c.district === slug).map(([f]) => f);
const statewide = L.markets.filter((m) => m.scope === "statewide");
const anyStale = Object.entries(S).some(([key, source]) => !["screwworm", "boll_weevil"].includes(key) && source.stale);
const drought = S.usdm.stale ? null : tx.drought;
const burnBans = S.burn_bans.stale ? null : tx.burn_bans;
const otherTopics = tx.headline?.items?.filter(({ topic }) => topic !== "drought" && topic !== "burn_bans").map(({ topic }) => topic);
const screwworm = tx.screwworm && S.screwworm && !S.screwworm.stale && !S.screwworm.delayed ? tx.screwworm : null;
const bollWeevil = tx.boll_weevil && S.boll_weevil && !S.boll_weevil.stale && S.boll_weevil.as_of && tx.boll_weevil.zones.length > 0;
const pests = [
  ...(screwworm ? [{
    label: "Livestock screwworm",
    detail: `${screwworm.active_animals} active animal ${screwworm.active_animals === 1 ? "case" : "cases"}`,
    href: "#screwworm-h",
    validUntil: screwworm.stale_at,
  }] : []),
  ...(bollWeevil ? [{
    label: "Cotton boll weevil",
    detail: `Report for ${day(S.boll_weevil.as_of, L.asof)}`,
    href: href("for/cotton/#boll-weevil"),
  }] : []),
];
---
<Base title="Texas agriculture this week · Texas Ag Dashboard" description="Drought, crop progress, cattle prices and burn bans for Texas, in plain language, from public data. Updated weekly." current="texas">
  <div class="overview">
    <div>
      <span class="eyebrow">Week of {day(L.asof)}</span>
      <h1>Texas agriculture this week</h1>
      <Headline headline={tx.headline} sources={S} asof={L.asof} topics={otherTopics?.length ? otherTopics : undefined} limit={1} />
      <Conditions asof={L.asof} drought={drought} burnBans={burnBans} pests={pests} />
      <details class="district-picker">
        <summary>Choose a district</summary>
        <nav aria-label="All Texas districts">
          <ul>{L.districts.map((d) => <li><a href={href(`district/${d.slug}/`)}>{d.name}</a></li>)}</ul>
        </nav>
      </details>
    </div>
    <DroughtMap counties={L.counties} showDrought={!S.usdm.stale} title="Texas counties" link={(f) => {
      const d = L.counties[f]?.district;
      return d ? href(`district/${d}/#c-${f}`) : null;
    }} labels={L.districts.map((d) => ({ text: d.name, fips: fipsOf(d.slug) }))} />
  </div>

  <section aria-labelledby="weekly-h">
    <h2 id="weekly-h">Weekly roundup</h2>
    <Headline headline={tx.headline} sources={S} asof={L.asof} />
    <nav class="personas" aria-label="Views by what you raise">
      <span class="eyebrow">See it for</span>
      <ul>{L.personas.map((p) => <li><a href={href(`for/${p.id}/`)}>{p.name}</a></li>)}</ul>
    </nav>
    {anyStale && <p class="notice warn">Some sources haven't updated recently, so their sections are hidden. See <a href={href("about/")}>About the data</a>.</p>}
  </section>

  <div class="condition-details">
    {drought && (
      <section aria-labelledby="drought-h">
        <h2 id="drought-h">Drought</h2>
        <p class="big">{pct(drought.now.d1)}</p>
        <p>{`of Texas is in drought (D1 or worse)`}{drought.week_ago ? `, ${change(drought.now.d1, drought.week_ago.d1)} from last week` : ""}{drought.year_ago ? ` and ${pct(drought.year_ago.d1)} a year ago` : ""}.</p>
        <DroughtBar levels={drought.now} label="Share of Texas by drought category" />
        <AsOf source={S.usdm} label="Map of" date={drought.map_date} note="official statewide figure" />
      </section>
    )}
    {burnBans && (
      <section aria-labelledby="burn-bans-h">
        <h2 id="burn-bans-h">Burn bans</h2>
        <p>{`${burnBans.count} of ${burnBans.of} counties have a burn ban.`}</p>
        <AsOf source={S.burn_bans} label="Updated" note="county judges set bans; check yours before burning" />
      </section>
    )}
  </div>

  <section aria-labelledby="districts-h">
    <h2 id="districts-h">Featured districts</h2>
    <p class="muted">{`These ${countWord(homes.length)} NASS agricultural statistics districts are the ones I started with. Every district has the same full view, with a card for every county: the other ${countWord(others.length)} are in the table below, or pick a county on the map. District figures are my own totals of county data, weighted by land area.`}</p>
    <div class="grid">
      {homes.map((d) => (
        <a class="card" href={href(`district/${d.slug}/`)} style="text-decoration:none;color:inherit">
          <h3>{d.name}</h3>
          {d.drought && <p>{`${pct(d.drought.now.d1)} in drought`}{d.drought.week_ago ? `, ${change(d.drought.now.d1, d.drought.week_ago.d1)} from last week` : ""}</p>}
          <dl class="kv">
            {d.rain_7d_in != null && (<><dt>Rain, last 7 days</dt><dd>{inches(d.rain_7d_in)}</dd></>)}
            {d.burn_bans != null && (<><dt>Counties with a burn ban</dt><dd>{`${d.burn_bans} of ${d.counties}`}</dd></>)}
          </dl>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="crops-h">
    <h2 id="crops-h">Crops</h2>
    <p class="muted">Statewide: NASS reports weekly crop progress and condition for Texas as a whole, not by district.</p>
    {S.nass.stale ? <p class="notice">Crop reports are hidden: NASS's newest report is older than I expect.</p> : (
      <div class="grid">
        {(["wheat", "cotton", "corn", "sorghum"] as const).map((c) => (
          <CropCard crop={c} progress={tx.crops[c].progress} condition={tx.crops[c].condition} source={S.nass} asof={L.asof} />
        ))}
        <CropCard crop="pasture" title="Pasture and range" condition={tx.pasture} source={S.nass} asof={L.asof} />
      </div>
    )}
  </section>

  <section aria-labelledby="cattle-h">
    <h2 id="cattle-h">Cattle markets</h2>
    <div class="grid">
      {statewide.map((m) => <MarketCard market={m} source={S.ams} asof={L.asof} />)}
    </div>
    <p class="muted">{"Local auctions: "}{L.markets.filter((m) => m.district && m.kind !== "sheep_goats").map((m, i) => (
      <>{i > 0 ? "; " : ""}<a href={href(`district/${m.district}/#mk-h`)}>{m.name}</a>{` (${L.districts.find((d) => d.slug === m.district)?.name})`}</>
    ))}{". All markets side by side: "}<a href={href("for/cattle-hay/")}>Cattle &amp; Hay</a>.</p>
  </section>

  {tx.screwworm && S.screwworm && <ScrewwormCard card={tx.screwworm} source={S.screwworm} asof={L.asof} />}

  <section aria-labelledby="rest-h">
    <h2 id="rest-h">Every other district</h2>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Other districts this week (scrolls sideways on small screens)">
      <table>
        <caption class="sr-only">Other NASS districts this week; each name links to its district page</caption>
        <thead><tr><th scope="col">District</th><th class="n" scope="col">In drought (D1+)</th><th class="n" scope="col">vs last week</th><th class="n" scope="col">{`Rain, 7 days to ${day(S.nclimgrid.as_of, L.asof)}`}</th><th class="n" scope="col">Rain vs normal, 30 days</th><th class="n" scope="col">Burn bans</th></tr></thead>
        <tbody>
          {others.map((d) => (
            <tr>
              <th scope="row"><a href={href(`district/${d.slug}/`)}>{d.name}</a></th>
              <td class="n">{d.drought ? pct(d.drought.now.d1) : "n/a"}</td>
              <td class="n">{d.drought?.week_ago ? change(d.drought.now.d1, d.drought.week_ago.d1) : "n/a"}</td>
              <td class="n">{inches(d.rain_7d_in)}</td>
              <td class="n">{d.rain_vs_normal?.pct != null ? `${d.rain_vs_normal.pct}%` : "n/a"}</td>
              <td class="n">{d.burn_bans != null ? `${d.burn_bans} of ${d.counties}` : "n/a"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="asof">Drought: {S.usdm.name}, map of {day(S.usdm.as_of)}. Rain: NOAA nClimGrid-Daily county averages through {day(S.nclimgrid.as_of)} (NOAA publishes about a week late); normal is 1991–2020. Our county-to-district totals.</p>
  </section>
</Base>

<style>
  .district-picker { position: relative; width: fit-content; margin-top: 1.25rem; }
  .district-picker summary {
    min-height: 44px;
    padding: .6rem .8rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-weight: 600;
    cursor: pointer;
  }
  .district-picker summary:hover { background: var(--paper-2); }
  .district-picker ul {
    position: absolute;
    z-index: 2;
    width: max-content;
    max-height: min(20rem, 45svh);
    overflow-y: auto;
    margin: .25rem 0 0;
    padding: .25rem;
    list-style: none;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
  }
  .district-picker a {
    display: block;
    min-height: 44px;
    padding: .6rem .75rem;
    line-height: 1.5;
    color: var(--ink);
  }
  .district-picker a:hover, .district-picker a:focus-visible { background: var(--paper-2); }
</style>
