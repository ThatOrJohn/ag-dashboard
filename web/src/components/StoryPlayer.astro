---
// The shared story player: date, caption, playback, chapters and the values table. The animation itself is
// one of the components in ./story/, chosen by the story's visual kind; each listens for "storyframe" events.
// Without JavaScript the first frame, the takeaway and the full table still render.
import { href } from "../lib/format";
import { chapterHoldMs, formatStoryValue, type Story, type StoryDisplayContext } from "../lib/stories/model";
import CattleMarket from "./story/CattleMarket.astro";
import CensusDots from "./story/CensusDots.astro";
import DroughtFlipbook from "./story/DroughtFlipbook.astro";
import FlyoverCards from "./story/FlyoverCards.astro";
import FlyoverMap from "./story/FlyoverMap.astro";
import FlyoverTable from "./story/FlyoverTable.astro";
import HarvestRace from "./story/HarvestRace.astro";
import RainGauges from "./story/RainGauges.astro";
import Reservoir from "./story/Reservoir.astro";
import RiverFlow from "./story/RiverFlow.astro";
import StoryTimeline from "./story/StoryTimeline.astro";
import Wells from "./story/Wells.astro";

interface Props {
  story: Story;
  context: StoryDisplayContext;
}

const { story, context } = Astro.props;
const flyover = story.visual.kind === "flyover" ? story.visual : null;
// Captions repeat across frames (each is its chapter's narration), so they travel once and frames point at them.
const captions = [...new Set(story.frames.map(({ caption }) => caption))];
const frames = story.frames.map(({ label, date, caption, values }) => ({
  label, date, c: captions.indexOf(caption), text: values.map((v, i) => formatStoryValue(v, story.series[i].unit)),
}));
const config = {
  frames, captions, names: story.series.map(({ name }) => name), frameMs: story.frameMs, holdMs: chapterHoldMs,
  chapters: story.chapters.map(({ frame }) => frame),
  stopSummaries: flyover?.stops.map(({ tiles }) => tiles.map(({ label, value }) => `${label} ${value}`).join(", ")),
};
const first = { ...frames[0], caption: captions[frames[0].c] };
const tableRows = (story.tableFrames ?? frames.map((_, i) => i)).map((i) => frames[i]);
const layout = ["drought", "census", "flyover"].includes(story.visual.kind) ? "layout-map" : "layout-wide";
const isCattle = story.visual.kind === "cattle";
const source = story.source && context.sources[story.source];
const districts = story.series.flatMap(({ slug, name }) => slug ? [{ slug, name }] : []);
---
<div class={`story-stage ${layout} kind-${story.visual.kind}${story.timeline || story.visual.kind === "drought" ? " has-timeline" : ""}`} id="story-player" data-story={JSON.stringify(config)}>
  {story.visual.kind === "drought" && <DroughtFlipbook story={story} context={context} />}
  {story.visual.kind === "rain" && <RainGauges story={story} />}
  {story.visual.kind === "harvest" && <HarvestRace story={story} />}
  {story.visual.kind === "reservoir" && <Reservoir story={story} />}
  {story.visual.kind === "wells" && <Wells story={story} />}
  {story.visual.kind === "river" && <RiverFlow story={story} />}
  {story.visual.kind === "cattle" && <CattleMarket story={story} />}
  {story.visual.kind === "census" && <CensusDots story={story} context={context} />}
  {story.timeline && <StoryTimeline story={story} timeline={story.timeline} />}
  {flyover && <>
    <FlyoverMap stops={flyover.stops} context={context} />
    <FlyoverCards stops={flyover.stops} sources={context.sources} />
    <div class="route chapters" role="group" aria-label="Flyover route" data-flyover-route hidden style={`--hold: ${chapterHoldMs}ms`}>
      {story.chapters.map(({ frame, label }, i) => (
        <button type="button" data-story-week={frame} aria-pressed={frame === 0 ? "true" : "false"}>
          <span class="stn" aria-hidden="true">{i === 0 || i === story.chapters.length - 1 ? "◎" : i}</span>{label}
        </button>
      ))}
    </div>
  </>}
  {!flyover && <section class="story-panel" aria-labelledby="story-metric">
    <time class="story-date" data-story-date datetime={first.date} hidden={!first.date}>{first.date && first.label}</time>
    <span class="story-date" data-story-label hidden={!!first.date}>{!first.date && first.label}</span>
    <h2 id="story-metric">{story.metric}</h2>
    {isCattle ? (
      <div class="caption-stack">
        <p class="story-caption" data-story-caption>{first.caption}</p>
        {captions.map((text) => <p class="story-caption caption-space" aria-hidden="true">{text}</p>)}
      </div>
    ) : <p class="story-caption" data-story-caption>{first.caption}</p>}
  </section>}
  <p class="sr-only" role="status" data-story-announcement></p>
  <div class="story-controls" data-story-controls hidden>
    <div class="timeline">
      <button class="play" type="button" data-story-play>
        <svg class="i-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5z" fill="currentColor" /></svg>
        <svg class="i-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5h3v11H3zM8 1.5h3v11H8z" fill="currentColor" /></svg>
        <span data-story-play-text>Play</span>
      </button>
      <label>{story.frameLabel}
        <input type="range" min="0" max={frames.length - 1} step="1" value="0" aria-valuetext={first.label} data-story-slider />
      </label>
    </div>
    {!flyover && <div class="chapters" role="group" aria-label="Story chapters">
      {story.chapters.map(({ frame, label }) => (
        <button type="button" data-story-week={frame} aria-pressed={frame === 0 ? "true" : "false"}>{label}</button>
      ))}
    </div>}
  </div>
</div>
<p class="asof">{story.method} {source?.url && <>Source data from <a href={source.url}>{source.name}</a>.</>}</p>
<section class="story-takeaway" aria-labelledby="story-takeaway">
  <h2 id="story-takeaway">{story.takeaway.title}</h2>
  <p>{story.takeaway.text}</p>
  <details class="story-table">
    <summary>See all figures</summary>
    {flyover ? <FlyoverTable stops={flyover.stops} sources={context.sources} /> : <div class="table-wrap">
      <table>
        <caption class="sr-only">{story.metric}</caption>
        <thead><tr><th scope="col">{story.frameLabel}</th>{story.series.map(({ name }) => <th scope="col" class="n">{name}</th>)}</tr></thead>
        <tbody>
          {tableRows.map(({ date, label, text }) => (
            <tr>
              <th scope="row">{date ? <time datetime={date}>{label}</time> : label}</th>
              {text.map((t) => <td class="n">{t}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>}
  </details>
  {districts.length > 0 && (
    <nav class="personas" aria-label="Current district conditions">
      <h3>See current district conditions</h3>
      <ul>{districts.map(({ slug, name }) => <li><a href={href("district/" + slug + "/")}>{name}</a></li>)}</ul>
    </nav>
  )}
  {story.related && <p><a href={href(story.related.href)}>{story.related.label}</a></p>}
</section>

<script>
  interface Config {
    frames: { label: string; date?: string; c: number; text: string[] }[];
    captions: string[];
    names: string[];
    frameMs: number;
    holdMs: number;
    chapters: number[];
    stopSummaries?: string[];
  }

  const player = document.getElementById("story-player")!;
  const { frames, captions, names, frameMs, holdMs, chapters: chapterFrames, stopSummaries }: Config = JSON.parse(player.dataset.story!);
  const q = <T extends HTMLElement>(s: string) => player.querySelector<T>(s)!;
  const controls = q("[data-story-controls]");
  const play = q<HTMLButtonElement>("[data-story-play]");
  const playText = q("[data-story-play-text]");
  const slider = q<HTMLInputElement>("[data-story-slider]");
  const date = player.querySelector<HTMLTimeElement>("[data-story-date]");
  const label = player.querySelector<HTMLElement>("[data-story-label]");
  const caption = player.querySelector<HTMLElement>(".story-panel [data-story-caption]");
  const announcement = q("[data-story-announcement]");
  const chapters = player.querySelectorAll<HTMLButtonElement>("[data-story-week]");
  const stopCards = player.querySelectorAll<HTMLElement>("[data-flyover-card]");
  const route = player.querySelector<HTMLElement>("[data-flyover-route]");
  const lastFrame = frames.length - 1;
  let frame = 0;
  let timer: number | undefined;

  function render(index: number) {
    frame = Math.max(0, Math.min(lastFrame, index));
    const next = frames[frame];
    if (date && label && caption) {
      date.hidden = !next.date;
      if (next.date) {
        date.dateTime = next.date;
        date.textContent = next.label;
      }
      label.hidden = !!next.date;
      label.textContent = next.label;
      if (caption.textContent !== captions[next.c]) caption.textContent = captions[next.c];
    }
    stopCards.forEach((card, i) => { card.hidden = i !== frame; });
    if (route) {
      const button = chapters[frame].getBoundingClientRect();
      const strip = route.getBoundingClientRect();
      if (button.left < strip.left || button.right > strip.right) {
        route.scrollLeft += button.left - strip.left - (route.clientWidth - button.width) / 2;
      }
    }
    slider.valueAsNumber = frame;
    slider.setAttribute("aria-valuetext", next.label);
    chapters.forEach((c) => c.setAttribute("aria-pressed", String(Number(c.dataset.storyWeek) === frame)));
    player.dispatchEvent(new CustomEvent("storyframe", { detail: { index: frame, playing: timer !== undefined } }));
  }

  function announce() {
    const current = frames[frame];
    const summary = stopSummaries?.[frame] ?? current.text.map((t, i) => names[i] + " " + t).join(", ");
    announcement.textContent = current.label + ". " + summary + ". " + captions[current.c];
  }

  function setPlaying(on: boolean) {
    player.classList.toggle("is-playing", on);
    playText.textContent = on ? "Pause" : frame === lastFrame ? "Replay" : "Play";
    play.classList.toggle("playing", on);
  }

  function pause() {
    window.clearTimeout(timer);
    timer = undefined;
    setPlaying(false);
  }

  function seek(index: number) {
    window.clearTimeout(timer);
    timer = undefined;
    render(index);
    setPlaying(false);
    announce();
  }

  function schedule() {
    timer = window.setTimeout(() => {
      render(frame + 1);
      if (frame === lastFrame) {
        pause();
        announce();
        return;
      }
      if (chapterFrames.includes(frame)) announce();
      schedule();
    }, chapterFrames.includes(frame) && frame !== 0 ? holdMs : frameMs);
  }

  play.addEventListener("click", () => {
    if (timer !== undefined) {
      pause();
      announce();
      return;
    }
    if (frame === lastFrame) render(0);
    timer = -1;   // marks playback as started so render() reports playing, before the first tick
    setPlaying(true);
    render(frame);
    schedule();
  });
  slider.addEventListener("input", () => seek(slider.valueAsNumber));
  chapters.forEach((c) => c.addEventListener("click", () => seek(Number(c.dataset.storyWeek))));
  player.addEventListener("storyseek", (e) => seek((e as CustomEvent<number>).detail));
  if (route) {
    stopCards.forEach((card, i) => { card.hidden = i !== 0; });
    player.dataset.ready = "";
    route.hidden = false;
  }
  controls.hidden = false;
</script>

<style>
  .story-stage {
    display: grid;
    gap: 0;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
  }
  /* Each visual's parts join this grid directly (display: contents) and are placed by area. */
  .story-stage.layout-map {
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr auto auto;
    grid-template-areas: "map panel" "map readout" "timeline timeline" "controls controls";
  }
  .story-stage.layout-wide {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "panel" "visual" "timeline" "controls";
  }
  .story-panel { grid-area: panel; padding: clamp(1rem, 3vw, 2rem) clamp(1rem, 3vw, 2rem) .5rem; }
  .story-date { display: block; font-family: var(--font-mono); font-size: clamp(1.05rem, 2vw, 1.3rem); color: var(--ink); }
  .story-date[hidden] { display: none; }
  .story-panel h2 { margin: .25rem 0 .6rem; font-size: clamp(1.15rem, 2.2vw, 1.5rem); }
  .story-caption { min-height: 3lh; margin: 0; color: var(--ink-2); max-width: 42rem; }
  .story-controls:not([hidden]) {
    grid-area: controls;
    display: grid;
    gap: .75rem;
    padding: .75rem clamp(1rem, 3vw, 2rem) clamp(1rem, 3vw, 1.5rem);
    border-top: 1px solid var(--rule);
    background: var(--paper);
  }
  .timeline { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .9rem; align-items: center; }
  .timeline label { display: grid; color: var(--ink-2); font-size: .85rem; }
  .timeline input { width: 100%; height: 2.75rem; margin: 0; accent-color: var(--accent); }
  :is(.story-controls, .route) button {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    min-height: 44px;
    padding: .45rem .8rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink-2);
    cursor: pointer;
    font: inherit;
    font-size: .9rem;
  }
  :is(.story-controls, .route) button:hover { border-color: var(--accent); }
  .story-controls .play { min-width: 6.5rem; justify-content: center; font-weight: 600; }
  .story-controls .play, :is(.story-controls, .route) button[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--accent-tint);
    color: var(--accent-ink);
  }
  .play .i-pause, .play.playing .i-play { display: none; }
  .play.playing .i-pause { display: inline; }
  .chapters { display: flex; flex-wrap: wrap; gap: .4rem; }
  /* The flyover route reads like a transit line: numbered stations on a rule, visited ones filled,
     and the current one shows how long it holds while playing. */
  .route {
    grid-area: timeline; min-width: 0; padding: .5rem .75rem; overflow-x: auto; flex-wrap: nowrap; gap: 0;
    border-top: 1px solid var(--rule); scrollbar-width: thin;
    mask-image: linear-gradient(90deg, transparent, #000 .75rem, #000 calc(100% - 1.5rem), transparent);
  }
  .route[hidden] { display: none; }
  .route button {
    position: relative; flex: 0 0 auto; gap: .4rem; overflow: hidden;
    border-color: transparent; background: none; padding-inline: .45rem .7rem;
  }
  .route button + button { margin-left: 1.1rem; }
  .route button + button::before {
    content: ""; position: absolute; right: 100%; top: 50%; width: 1.1rem; border-top: 2px dotted var(--ink-3);
  }
  .route .stn {
    display: inline-grid; place-items: center; flex: none; width: 1.45rem; height: 1.45rem; border-radius: 50%;
    border: 1.5px solid var(--ink-3); font: 600 .72rem var(--font-mono); color: var(--ink-2); background: var(--paper);
  }
  .route button:has(~ [aria-pressed="true"]) .stn { border-color: var(--accent); background: var(--accent-tint); color: var(--accent-ink); }
  .route button[aria-pressed="true"] .stn { border-color: var(--accent); background: var(--accent); color: var(--paper); }
  .route button[aria-pressed="true"]::after {
    content: ""; position: absolute; left: 0; bottom: 0; height: 3px; width: 100%;
    background: var(--accent); transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    .is-playing .route button[aria-pressed="true"]::after { animation: hold var(--hold, 2.6s) linear both; }
    @keyframes hold { from { transform: scaleX(0); } }
  }
  .story-stage.kind-flyover {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto;
    grid-template-areas: "map" "timeline" "panel" "controls";
  }
  .story-takeaway { max-width: 48rem; }
  .story-table { margin: 1.25rem 0; border-block: 1px solid var(--rule); }
  .story-table summary { padding: .7rem 0; cursor: pointer; min-height: 44px; display: flex; align-items: center; }
  .story-table table { margin-bottom: .75rem; }
  .story-table th.n { font-family: inherit; }
  .story-table td, .story-table th { padding-inline: clamp(.25rem, 1.25vw, .5rem); }
  /* Size the caption to the longest wrapped chapter so playback never moves the controls. */
  .caption-stack { display: grid; }
  .caption-stack .story-caption { grid-area: 1 / 1; min-height: 0; font-size: .95rem; }
  .caption-space { visibility: hidden; }
  .kind-cattle .story-panel { padding: .65rem 1rem .35rem; }
  .kind-cattle .story-panel h2 { margin: .15rem 0 .3rem; }
  .kind-cattle .story-controls:not([hidden]) { gap: .4rem; padding: .35rem 1rem .6rem; }
  @media (max-width: 999px) {
    .story-stage.kind-cattle { grid-template-areas: "panel" "visual" "controls" "timeline"; }
  }
  /* Desktop: the visual (and its timeline) on the left; date, caption, readout and controls in a column on the
     right, so the player fits on one screen. Visuals cap their height with --vis-max. */
  @media (min-width: 1000px) {
    .story-stage { --vis-max: max(14rem, calc(100svh - 22rem)); }
    .story-stage.has-timeline { --vis-max: max(12rem, calc(100svh - 30rem)); }
    .story-stage.layout-wide { grid-template-columns: minmax(0, 1.75fr) minmax(19rem, 1fr); }
    .story-stage.layout-map { grid-template-columns: minmax(0, 1fr) minmax(22rem, 1fr); }
    .story-stage.layout-map {
      grid-template-rows: auto auto 1fr auto;
      grid-template-areas: "map panel" "map readout" "map controls" "timeline controls";
    }
    .story-stage.kind-flyover {
      --vis-max: max(14rem, calc(100svh - 24rem));
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr auto;
      grid-template-areas: "map panel" "map controls" "timeline controls";
    }
    .story-stage.layout-wide {
      grid-template-rows: auto 1fr auto;
      grid-template-areas: "visual panel" "visual controls" "timeline controls";
    }
    .story-stage.layout-wide > :first-child { align-self: center; }
    .story-panel { padding: 1rem 1.5rem .4rem; border-left: 1px solid var(--rule); }
    .story-date { font-size: 1.1rem; }
    .story-panel h2 { font-size: 1.3rem; margin-bottom: .4rem; }
    .story-stage.layout-map .story-panel { border-left: 0; }
    .story-caption { min-height: 4lh; font-size: .95rem; }
    .story-stage.layout-map .story-caption { min-height: 3lh; }
    .story-controls:not([hidden]) {
      align-content: end;
      gap: .6rem;
      padding: .75rem 1.5rem 1rem;
      border-left: 1px solid var(--rule);
    }
    .story-stage.layout-wide .story-controls:not([hidden]) { border-top: 0; }
    .story-stage.kind-cattle .story-controls:not([hidden]) { align-content: start; }
    .story-stage.layout-map .story-controls:not([hidden]) { border-left: 0; }
    .timeline { gap: .75rem; }
    .chapters { gap: .35rem; }
    .story-controls button { padding: .4rem .65rem; font-size: .85rem; }
  }
  @media (min-width: 1000px) and (max-height: 860px) {
    .kind-drought .chapters { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .kind-drought .chapters button { justify-content: center; text-align: center; }
  }
  @media (max-width: 760px) {
    .story-stage.layout-map {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: "panel" "map" "readout" "timeline" "controls";
    }
    .story-caption { min-height: 4lh; }
  }
</style>
