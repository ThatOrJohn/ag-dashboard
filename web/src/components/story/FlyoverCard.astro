---
// A Stories index card for a flyover: a build-time thumbnail of the area with the tour's numbered route on
// it, so tours read as places to visit rather than charts to replay (those keep the plain text card).
import { href } from "../../lib/format";
import type { BuiltStory } from "../../lib/stories";
import { flyoverGeometry } from "../../lib/stories/flyoverMap";

interface Props {
  built: BuiltStory;
  level: 3 | 4 | 5;
}
const { built: { story, path, context }, level } = Astro.props;
const stops = story?.visual.kind === "flyover" ? story.visual.stops : [];
const width = 400, height = 250;
const { shapes, borders, points, legs, whole } = flyoverGeometry(stops, context, width, height, { scenes: false });
const places = stops.slice(1, -1).map(({ name }) => name.replace(/ County$/, ""));
const shown = places.slice(0, 4);
const Title = `h${level}` as const;
const z = whole[2] / width;
const r = (n: number) => n.toFixed(1);
---
{story && (
  <article class="tour-card">
    <svg class:list={["thumb", { busy: places.length > 7 }]} viewBox={whole.join(" ")} aria-hidden="true" style={`--z: ${z}`}>
      {shapes.map(({ d, stop }) => <path class:list={["land", { visited: stop != null }]} d={d} />)}
      <path class="edge" d={borders} />
      {legs.map(({ d }) => <path class="leg" d={d} />)}
      {points.map((point, i) => point && (
        <g transform={`translate(${r(point[0])} ${r(point[1])}) scale(${z.toFixed(3)})`} class="wp">
          <circle r="9" /><text text-anchor="middle" dy=".36em">{i}</text>
        </g>
      ))}
    </svg>
    <div class="body">
      <p class="eyebrow"><span class="kind">Flyover</span> · {story.period} · {places.length} stops</p>
      <Title class="title"><a href={href(`stories/${path}/`)}>{story.title}</a></Title>
      <p class="desc">{story.description}</p>
      <ol class="route" aria-label="Stops">
        {shown.map((name, i) => <li><span aria-hidden="true">{i + 1}</span>{name}</li>)}
        {places.length > shown.length && <li class="more">+{places.length - shown.length} more</li>}
      </ol>
    </div>
  </article>
)}

<style>
  .tour-card {
    position: relative; display: flex; flex-direction: column; overflow: hidden;
    border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper);
    --sea: var(--paper-2); --land: var(--paper);
  }
  :global(.dark) .tour-card { --sea: var(--paper); --land: var(--paper-3); }
  .tour-card:hover, .tour-card:focus-within { border-color: var(--accent); }
  .tour-card:has(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .thumb {
    display: block; width: 100%; aspect-ratio: 8 / 5; height: auto; background-color: var(--sea);
    background-image: linear-gradient(var(--rule-2) 1px, transparent 1px), linear-gradient(90deg, var(--rule-2) 1px, transparent 1px);
    background-size: 1.25rem 1.25rem; border-bottom: 1px solid var(--rule);
  }
  .land { fill: var(--land); stroke: var(--rule); stroke-width: .5; vector-effect: non-scaling-stroke; }
  .land.visited { fill: var(--accent-tint); }
  .edge { fill: none; stroke: var(--ink-3); stroke-width: .8; vector-effect: non-scaling-stroke; }
  .leg { fill: none; stroke: var(--accent); stroke-width: calc(var(--z) * 2px); stroke-linecap: round;
    stroke-dasharray: calc(var(--z) * 5px) calc(var(--z) * 4px); }
  /* Long tours zigzag across the map; keep their legs quiet so the waypoints carry the picture. */
  .busy .leg { opacity: .45; stroke-width: calc(var(--z) * 1.4px); }
  .wp circle { fill: var(--accent); stroke: var(--land); stroke-width: 1.5; }
  .wp text { fill: var(--paper); font: 600 10px var(--font-mono); }
  .tour-card:hover .leg { animation: march 1s linear infinite; }
  @media (prefers-reduced-motion: reduce) { .tour-card:hover .leg { animation: none; } }
  @keyframes march { to { stroke-dashoffset: calc(var(--z) * -9px); } }

  .body { display: flex; flex-direction: column; flex: 1; padding: .85rem 1.1rem 1rem; }
  .eyebrow { margin: 0 0 .35rem; }
  .kind { color: var(--accent-ink); font-weight: 600; }
  .title { margin: 0 0 .35rem; font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.25; }
  .title a { color: var(--ink); text-decoration: none; }
  .title a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .title a:focus-visible { outline: none; }
  .tour-card:hover .title a { color: var(--accent-ink); }
  .desc { margin: 0 0 .7rem; color: var(--ink-2); font-size: .92rem; }
  .route { display: flex; flex-wrap: wrap; gap: .3rem .9rem; margin: auto 0 0; padding: 0; list-style: none; font-size: .8rem; color: var(--ink-2); }
  .route li { display: inline-flex; align-items: center; gap: .3rem; }
  .route span {
    display: inline-grid; place-items: center; width: 1.1rem; height: 1.1rem; border-radius: 50%;
    background: var(--accent-tint); color: var(--accent-ink); font: 600 .65rem var(--font-mono);
  }
  .route .more { color: var(--ink-3); }
</style>
